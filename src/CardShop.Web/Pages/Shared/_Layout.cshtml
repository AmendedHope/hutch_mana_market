<!DOCTYPE html>
@{
    var currentPage = ViewContext.RouteData.Values["page"] as string;
    string Active(string page) => string.Equals(currentPage, page, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    string? Current(string page) => Active(page) == "active" ? "page" : null;
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HutchisMuch Mana Shop</title>
    <script>
        // Apply the saved theme (or the system setting) before the page draws, so there's no flash.
        (function () {
            try {
                var t = localStorage.getItem('theme');
                if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                document.documentElement.setAttribute('data-theme', t);
            } catch (e) { document.documentElement.setAttribute('data-theme', 'light'); }
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/eggs.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CardShop.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <nav class="navbar navbar-expand-md">
            <div class="container">
                <a class="brand me-4" asp-page="/Index">
                    <span class="brand-mark" aria-hidden="true"></span>
                    <span class="brand-name">HutchisMuch <span>Mana Shop</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-between" id="mainNav">
                    <ul class="nav-pills-x">
                        <li><a class="@Active("/Index")" aria-current="@Current("/Index")" asp-page="/Index">Home</a></li>
                        <li><a class="@Active("/Cards")" aria-current="@Current("/Cards")" asp-page="/Cards">Cards</a></li>
                        <li><a class="@Active("/Analytics")" aria-current="@Current("/Analytics")" asp-page="/Analytics">Analytics</a></li>
                        <li><a class="@Active("/Import")" aria-current="@Current("/Import")" asp-page="/Import">Import</a></li>
                        <li><a class="@Active("/Sync")" aria-current="@Current("/Sync")" asp-page="/Sync">Sync</a></li>
                    </ul>
                    <div class="nav-tools">
                        <button type="button" class="icon-btn theme-toggle" id="themeToggle" aria-label="Switch to dark mode" title="Switch theme">
                            <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
                            <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                        </button>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="who d-none d-lg-inline">Hi, <strong>@User.Identity.Name</strong></span>
                            <form method="post" asp-page="/Logout" class="m-0">
                                <button type="submit" class="btn-x ghost small">Sign out</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container">
            <span>&copy; @DateTime.Now.Year HutchisMuch Mana Shop</span>
            <span><a asp-page="/Privacy">Privacy</a> &middot; Prices from TCGCSV &middot; <span title="Psst: type it anywhere">Try typing <kbd>disco</kbd></span></span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/eggs.js" asp-append-version="true"></script>
</body>
</html>
