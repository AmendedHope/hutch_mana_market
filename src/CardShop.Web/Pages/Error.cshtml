@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="panel text-center mx-auto" style="max-width: 560px; margin-top: 3rem; padding: 2.5rem 2rem;">
    <div class="page-icon mx-auto mb-3" style="display:grid;place-items:center;width:64px;height:64px;border-radius:20px;color:#fff;background:linear-gradient(135deg,#f43f5e,#fb923c)">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg>
    </div>
    <h1 style="font-size:1.8rem;font-weight:800">Something went wrong</h1>
    <p class="text-muted">That didn't work as planned. Try again in a moment. If it keeps happening, the server logs will have the details.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Reference: <code>@Model.RequestId</code></p>
    }
    <div class="d-flex gap-2 justify-content-center mt-3">
        <a class="btn-x primary" href="/">Back to home</a>
        <a class="btn-x ghost" href="javascript:history.back()">Go back</a>
    </div>
</div>
